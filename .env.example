# SPARC Platform Environment Configuration

# Cryptographic Uplink Authorization Key for Telecommand Signing
ISTRAC_UPLINK_SECRET_KEY=ISRO-SPARC-AUTONOMOUS-TELECOMMAND-AUTH-KEY-V1

# NOAA Space Weather Prediction Center (SWPC) Real-Time Endpoints
NOAA_SWPC_PLASMA_URL=https://services.swpc.noaa.gov/json/solar-wind/plasma-5-minute.json
NOAA_SWPC_MAG_URL=https://services.swpc.noaa.gov/json/solar-wind/mag-5-minute.json
NOAA_SWPC_PROTON_URL=https://services.swpc.noaa.gov/json/goes/primary/integral-protons-1-day.json

# CelesTrak TLE Ingestion URL
CELESTRAK_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=tle

# Configuration Paths
FLEET_CONFIG_PATH=config/fleet.json
